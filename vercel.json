{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/privacy", "destination": "/privacy-policy", "permanent": true },
    { "source": "/terms-of-use", "destination": "/terms", "permanent": true },
    { "source": "/help", "destination": "/support", "permanent": true },
    { "source": "/otp-viewer", "destination": "/admin/otp-viewer", "permanent": true },
    { "source": "/app-shell", "destination": "/admin", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/app-shell.html" },
    { "source": "/admin/:path*", "destination": "/app-shell.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/admin(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "functions": {
    "api/admin-mail.ts": {
      "maxDuration": 30
    }
  }
}
