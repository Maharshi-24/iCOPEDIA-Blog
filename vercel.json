{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/manufacturers", "missing": [{ "type": "host", "value": "manufacturer.icopedia.co" }], "destination": "/", "permanent": false },
    { "source": "/about", "has": [{ "type": "host", "value": "manufacturer.icopedia.co" }], "destination": "https://icopedia.co/about", "permanent": false },
    { "source": "/support", "has": [{ "type": "host", "value": "manufacturer.icopedia.co" }], "destination": "https://icopedia.co/support", "permanent": false },
    { "source": "/terms", "has": [{ "type": "host", "value": "manufacturer.icopedia.co" }], "destination": "https://icopedia.co/terms", "permanent": false },
    { "source": "/privacy-policy", "has": [{ "type": "host", "value": "manufacturer.icopedia.co" }], "destination": "https://icopedia.co/privacy-policy", "permanent": false },
    { "source": "/admin", "has": [{ "type": "host", "value": "manufacturer.icopedia.co" }], "destination": "https://icopedia.co/admin", "permanent": false },
    { "source": "/admin/:path*", "has": [{ "type": "host", "value": "manufacturer.icopedia.co" }], "destination": "https://icopedia.co/admin/:path*", "permanent": false },
    { "source": "/otp-viewer", "has": [{ "type": "host", "value": "manufacturer.icopedia.co" }], "destination": "https://icopedia.co/admin/otp-viewer", "permanent": false },
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/privacy", "destination": "/privacy-policy", "permanent": true },
    { "source": "/terms-of-use", "destination": "/terms", "permanent": true },
    { "source": "/help", "destination": "/support", "permanent": true },
    { "source": "/about-us", "destination": "/about", "permanent": true },
    { "source": "/otp-viewer", "destination": "/admin/otp-viewer", "permanent": true },
    { "source": "/app-shell", "destination": "/admin", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/app-shell" },
    { "source": "/admin/:path*", "destination": "/app-shell" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" }
      ]
    },
    {
      "source": "/((?!admin|api).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/admin(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "manufacturer.icopedia.co" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "functions": {
    "api/admin-mail.ts": {
      "maxDuration": 30
    }
  }
}
